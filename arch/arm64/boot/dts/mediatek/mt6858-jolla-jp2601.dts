/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/linux-event-codes.h>

#include "mt6858.dtsi"

/ {
	model = "Jolla Phone (2026)";
	compatible = "jolla,jp2601", "mediatek,mt6858";

	aliases {
		i2c0 = &i2c0;
		i2c3 = &i2c3;
		i2c4 = &i2c4;
		i2c5 = &i2c5;
		i2c7 = &i2c7;
		i2c8 = &i2c8;
		i2c12 = &i2c12;
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:921600n8";
	};

	memory@40000000 {
		device_type = "memory";
		/* Bootloader fills this in based on hardware variant */
		reg = <0x0 0x40000000 0x0 0x0>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/*
		 * Reserved memory regions are allocated dynamically, and their
		 * locations and sizes may vary depending on the firmware build
		 * and the memory size. This node must exist for the bootloader
		 * to fill them in.
		 */
	};

	gpio-keys {
		compatible = "gpio-keys";

		key-volumeup {
			gpios = <&pio 120 GPIO_ACTIVE_LOW>;
			debounce-interval = <16>;
			linux,code = <KEY_VOLUMEUP>;
			wakeup-source;
		};

		switch-hall {
			gpios = <&pio 13 GPIO_ACTIVE_LOW>;
			debounce-interval = <125>;
			linux,input-type = <EV_SW>;
			linux,code = <SW_LID>;
			wakeup-source;
		};

		switch-side {
			gpios = <&pio 1 GPIO_ACTIVE_HIGH>;
			debounce-interval = <100>;
			linux,input-type = <EV_SW>;
			linux,code = <SW_MUTE_DEVICE>;
			wakeup-source;
		};
	};
};

&i2c0 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pins>;
	status = "okay";

	/* TOH connector */
};

&i2c3 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3_pins>;
	status = "okay";

	/* 0x08: NFC */
};

&i2c4 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c4_pins>;
	status = "okay";

	/* 0x1a: Front camera */
	/* 0x51: Front camera EEPROM */
};

&i2c5 {
	clock-frequency = <1000000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c5_pins>;

	#address-cells = <1>;
	#size-cells = <0>;

	status = "okay";

	/* 0x34 etc.: MT6720 PMIC */

	/* connectivity supply */
	regulator@75 {
		compatible = "richtek,rt6160";
		reg = <0x75>;
		regulator-name = "rt6160-buckboost";
		regulator-min-microvolt = <3450000>;
		regulator-max-microvolt = <3650000>;
		regulator-always-on;
	};
};

&i2c7 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c7_pins>;
	status = "okay";

	/* 0x0c: Second camera focus */
	/* 0x10: Second camera */
	/* 0x50: Second camera EEPROM */
};

&i2c8 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c8_pins>;
	status = "okay";

	/* 0x0c: Main camera focus */
	/* 0x1a: Main camera */
	/* 0x50: Main camera EEPROM */
};

&i2c12 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c12_pins>;
	status = "okay";

	/* 0x45: AW2023 LED controller */
};

&pio {
	i2c0_pins: i2c0-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO139__FUNC_SCL0>,
				 <PINMUX_GPIO140__FUNC_SDA0>;
			bias-pull-up = <MTK_PULL_SET_RSEL_001>;
			drive-strength = <4>;
			input-enable;
		};
	};

	i2c3_pins: i2c3-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO145__FUNC_SCL3>,
				 <PINMUX_GPIO146__FUNC_SDA3>;
			bias-pull-up = <MTK_PULL_SET_RSEL_001>;
			drive-strength = <4>;
			input-enable;
		};
	};

	i2c4_pins: i2c4-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO147__FUNC_SCL4>,
				 <PINMUX_GPIO148__FUNC_SDA4>;
			bias-pull-up = <MTK_PULL_SET_RSEL_001>;
			drive-strength = <4>;
			input-enable;
		};
	};

	i2c5_pins: i2c5-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO149__FUNC_SCL5>,
				 <PINMUX_GPIO150__FUNC_SDA5>;
			bias-pull-up = <MTK_PULL_SET_RSEL_001>;
			drive-strength = <4>;
			input-enable;
		};
	};

	i2c7_pins: i2c7-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO153__FUNC_SCL7>,
				 <PINMUX_GPIO154__FUNC_SDA7>;
			bias-pull-up = <MTK_PULL_SET_RSEL_001>;
			drive-strength = <4>;
			input-enable;
		};
	};

	i2c8_pins: i2c8-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO155__FUNC_SCL8>,
				 <PINMUX_GPIO156__FUNC_SDA8>;
			bias-pull-up = <MTK_PULL_SET_RSEL_001>;
			drive-strength = <4>;
			input-enable;
		};
	};

	i2c12_pins: i2c12-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO163__FUNC_SCL12>,
				 <PINMUX_GPIO164__FUNC_SDA12>;
			bias-pull-up = <MTK_PULL_SET_RSEL_001>;
			drive-strength = <4>;
			input-enable;
		};
	};

	uart0_pins: uart0-pins {
		pins {
			pinmux = <PINMUX_GPIO49__FUNC_UTXD0>,
				 <PINMUX_GPIO50__FUNC_URXD0>;
		};
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pins>;
	status = "okay";
};
